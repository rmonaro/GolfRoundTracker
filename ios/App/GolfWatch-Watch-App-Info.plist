<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- REQUIRED for `allowsBackgroundLocationUpdates`. Without it Core
		     Location raises when we set that flag, and — worse, silently —
		     stops delivering fixes the moment the wrist drops, which froze the
		     live yardage until the golfer opened their phone.

		     watchOS declares location under UIBackgroundModes, NOT
		     WKBackgroundModes. UIBackgroundModes has been available on watchOS
		     since 4.0; WKBackgroundModes takes ONLY the six watch-specific
		     values (workout-processing, self-care, mindfulness,
		     physical-therapy, alarm, underwater-depth). Putting `location`
		     there fails App Store validation with "Invalid Info.plist value…
		     for the key 'WKBackgroundModes'" — the archive uploads, then the
		     build is rejected. -->
		<string>location</string>
	</array>
	<key>WKBackgroundModes</key>
	<array>
		<!-- Keeps the app running wrist-down for the whole round (motion +
		     heart rate). Started by RoundShotController's HKWorkoutSession. -->
		<string>workout-processing</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Golf Round Tracker uses your location to show live distance to the pin and to place your shots on the hole map.</string>
</dict>
</plist>
