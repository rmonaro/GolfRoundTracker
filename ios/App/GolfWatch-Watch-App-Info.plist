<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CoreLocation reads THIS key — not WKBackgroundModes — when deciding
	     whether `allowsBackgroundLocationUpdates` may be set. Leaving it empty
	     while declaring `location` below is what threw:
	       "Invalid parameter not satisfying: !stayUp ||
	        CLClientIsBackgroundable(internal->fClient) || _CFMZEnabled()"
	     Both keys are required and they are not interchangeable. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- watchOS extended-runtime session types. `workout-processing` is what
	     keeps the app scheduled wrist-down for the whole round (started by
	     RoundShotController's HKWorkoutSession); `location` is the watchOS-side
	     declaration that pairs with UIBackgroundModes above. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Golf Round Tracker uses your location to show live distance to the pin and to place your shots on the hole map.</string>
</dict>
</plist>
