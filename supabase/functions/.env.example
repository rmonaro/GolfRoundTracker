# Secrets for the `tm-integration` edge function (TournamentManagement link).
# Copy to `supabase/functions/.env` for local `supabase functions serve`, and in
# production set them with `supabase secrets set KEY=value`.
#
# These are server-side only — they are NEVER exposed to the GRT client, which
# is exactly why the TM calls are proxied through the edge function.

# Base URL of the TournamentManagement app (no trailing slash).
#   local:      http://host.docker.internal:3000   (TM running on :3000)
#   production: https://your-tm.vercel.app
TM_BASE_URL=

# Shared integration secret. MUST equal the INTEGRATION_API_KEY set in TM's .env.
INTEGRATION_API_KEY=

# Optional. Only needed if the TM Vercel deployment keeps Deployment Protection
# ON. Create a "Protection Bypass for Automation" token in the TM Vercel project
# (Settings → Deployment Protection) and put it here so server-to-server calls
# aren't bounced to Vercel's login wall. Leave empty if protection is disabled.
#   https://vercel.com/docs/deployment-protection/methods-to-bypass-deployment-protection/protection-bypass-automation
TM_BYPASS_TOKEN=

# OpenGolfAPI dev key (https://opengolfapi.org/developer). Reads work without
# one, but a key raises the daily quota from 500 to 10,000 requests — which the
# coordinate backfill and any bulk state import will need.
# Used by: courses-api (backfillCoords*).
OPENGOLF_API_KEY=

# FairwayMapper Overpass mirror (https://www.fairwaymapper.com/ — Plans & pricing).
# Optional. When set, sync-course-osm tries this keyed mirror FIRST and falls
# back to the public ones; when unset it is skipped entirely and behaviour is
# unchanged.
#
# Worth having because the public mirrors fail from Supabase's egress in three
# different ways at once: overpass-api.de returns 406 (mod_security), kumi times
# out, and overpass.osm.ch answers 200 from a stale snapshot. A keyed mirror has
# no reason to do any of that.
#
# Note this buys QUERY ACCESS, not a data licence — Overpass returns OSM data
# under ODbL, so anything already synced stays valid if the subscription ends.
# Used by: sync-course-osm.
FAIRWAYMAPPER_API_KEY=
